# Application
CBSE_BASE_URL=https://your-environment.example/
# REST API host, used by the API-level tests. This is a different host to
# CBSE_BASE_URL, which serves only the SPA - /api/* paths under the SPA host
# return its HTML 404 page rather than reaching the API.
CBSE_API_BASE_URL=https://your-api-environment.example

# Primary logins
CBSE_TEACHER_USERNAME=teacher@example.com
CBSE_TEACHER_PASSWORD=replace_me
CBSE_SME_USERNAME=sme@example.com
CBSE_SME_PASSWORD=replace_me
CBSE_SME2_USERNAME=sme2@example.com
CBSE_PIT1_USERNAME=pit1@example.com
CBSE_ALL_USERS_PASSWORD=replace_me

# Comma-separated accounts used by role-based tests
CBSE_ADMIN_USERNAMES=admin@example.com
CBSE_SME_USERNAMES=sme1@example.com,sme2@example.com
CBSE_TEACHER_USERNAMES=teacher1@example.com,teacher2@example.com
CBSE_RWG_USERNAMES=rwg1@example.com,rwg2@example.com
CBSE_SR_RWG_USERNAMES=sr-rwg1@example.com,sr-rwg2@example.com
CBSE_PIT_USERNAMES=pit1@example.com,pit2@example.com,pit3@example.com

# Optional
CBSE_UPLOAD_ITEM_FILE=C:\Users\your-name\Downloads\sme_sheet.xlsx
