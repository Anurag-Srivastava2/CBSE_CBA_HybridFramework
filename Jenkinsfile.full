// Complete CBSE CBA suite — every module, in parallel lanes.
//
// The lanes are not one-per-module, and that is the whole design. The portal
// allows one active session per account, and several modules share accounts:
//
//   M1  SME pool (worker-pinned) + RWG/SR-RWG/PIT reviewers
//   M5  primary teacher          + RWG/SR-RWG/PIT reviewers   <- shares with M1
//   M4  teacher2, chosen deliberately so QP work never meets M5's contributor
//   M2  admin + admin2; its `serial` tests deactivate RWG accounts outright
//   M3  a login-and-render probe, no state of its own
//
// So the lanes are drawn along account boundaries, not directory boundaries:
//
//   M2       admin only, with the RWG-deactivating `serial` tests held back
//   M3+M4    probe + teacher2
//   M1+M5    one pytest process over M1 and M5, so xdist's global `serial`
//            group covers the reviewer flows of both at once — separate
//            processes would each keep their own serial worker and
//            double-book the reviewers. They also share tmp_uploads/, which
//            one process schedules safely and several do not.
//   tail     M2's `serial` tests, after the parallel block: deactivating RWG
//            mid-flight would fail M1 and M5 for a reason that is not a bug.
//
// Wall clock is therefore bounded by the M1+M5 lane, with everything else
// hidden underneath it. Splitting M1 from M5 would not go faster — it would
// just trade a long build for a flaky one. More real parallelism needs more
// accounts, not more lanes; see docs/jenkins_setup.md section 6.
//
// Accounts per lane: each lane is its own pytest process, and xdist numbers
// workers from gw0 in every process, so without help every lane's first worker
// would drive sme1/teacher1 at once and sign the others out. The M2 and M3+M4
// lanes therefore start CBSE_ACCOUNT_SLOT_OFFSET entries along the pools, just
// past the WORKERS accounts M1+M5 holds - and never before entry 2, because the
// teacher triple-revision e2e always drives teacher2 (the first teacher after
// the primary), whatever its slot. With the default 1/1/1 workers that is
// M1+M5 sme1 / teacher1 (+ teacher2 for that e2e), M2 sme3 / teacher7, M4
// teacher3. The pools wrap, so keep CBSE_SME_USERNAMES and
// CBSE_TEACHER_USERNAMES longer than the workers drawing on them, or two lanes
// share an account again.
//
// Covers the five module folders tests/M1_* .. tests/M5_* only. Deliberately
// left out: tests/_unit and the two top-level files tests/test_qar_retry_flow.py
// and tests/test_manual_typology_coverage.py (the module job still runs them
// for M1), and tests/_tmp_report_check/, which holds synthetic report fixtures.
//
// Daily run: create a second job named `cbse-daily` from this same file. The
// 10:00 IST schedule and the team summary mail switch on for that job name
// only, so `cbse-full` stays a by-hand run with its own build history. See
// docs/jenkins_pipelines.md, "Daily regression".
//
// Related files:
//   Jenkinsfile         post-deployment smoke gate (critical paths only)
//   Jenkinsfile.module  one module at a time

def cbse
// Holds the daily summary's one-line status between the post steps.
def summarySubject

pipeline {
    agent any

    // Scheduled for the daily job only; every other job built from this file
    // gets an empty spec, which is no schedule at all. Jenkins registers the
    // trigger when a build runs, so the schedule starts after the first build.
    // The literal job name is repeated in SEND_REPORT below: declarative
    // directives cannot see a script-level constant reliably.
    triggers {
        cron(env.JOB_BASE_NAME == 'cbse-daily' ? 'TZ=Asia/Kolkata\n0 10 * * *' : '')
    }

    parameters {
        string(
            name: 'CBSE_BASE_URL',
            defaultValue: 'https://cbse-qa-new.akashic.dhira.io/',
            description: 'Environment under test.'
        )
        string(
            name: 'WORKERS',
            // Was 4. Build #2 (2026-09-30) lost 16 tests to the portal's
            // sign-in rate limit with 7 browsers signing in across the lanes;
            // it locks accounts after bursts of logins from one machine, and
            // utilities/login_gate.py's spacing alone did not keep under it.
            // Was 2 until 2026-10-05: the team asked for one worker per lane.
            // The lanes still run side by side (3 browsers at peak); M1+M5
            // runs its tests one at a time, which is why its timeout is 360.
            defaultValue: '1',
            description: 'xdist workers for the M1+M5 lane — the critical path, so this is the number that moves the build time. Each worker drives its own headless Chrome (~200 MB). Kept low on purpose: the portal rate-limits sign-ins per machine, and more parallel browsers mean more lockouts, which fail tests for a reason that is not a bug.'
        )
        string(
            name: 'LIGHT_WORKERS',
            defaultValue: '1',
            description: 'xdist workers for the M3+M4 lane. Peak concurrent browsers is WORKERS + LIGHT_WORKERS + M2_WORKERS (4 by default); raising any of them raises sign-in lockouts.'
        )
        string(
            name: 'M2_WORKERS',
            defaultValue: '1',
            description: 'xdist workers for the M2 lane. Each worker takes its own admin from CBSE_ADMIN_USERNAMES + CBSE_ADMIN2_USERNAME; with one admin configured, a second worker signs the first out. Raise only to the number of admin accounts in the credential.'
        )
        string(
            name: 'RERUNS',
            defaultValue: '0',
            description: 'Retries for failed tests. 0 keeps the per-test @flaky markers in charge, which is normally right — a blanket retry hides real regressions and doubles the cost of a genuine failure. Raise to 1 only for a known-noisy environment.'
        )
        booleanParam(
            name: 'INCLUDE_NIGHTLY',
            defaultValue: false,
            description: 'Also run the nightly tests, which assert on AI/model verdicts rather than application logic. They fail on model drift, so they do not belong in a gate.'
        )
        booleanParam(
            name: 'INCLUDE_PERFORMANCE',
            defaultValue: false,
            description: 'Also run the performance budgets (TC-IBMM-08-P01 and friends). They measure wall-clock against a shared backend that does not currently meet the budget, so they are a standing red on a gate — and under -n the contention lands inside the measurement. Use the module job with SUITE=performance and WORKERS=1 for a trustworthy number.'
        )
        booleanParam(
            name: 'SEND_REPORT',
            defaultValue: env.JOB_BASE_NAME == 'cbse-daily',
            description: 'Mail the module summary to the team when the build finishes. On by default for the cbse-daily job only.'
        )
        string(
            name: 'NOTIFY_EMAILS',
            defaultValue: '',
            description: 'Comma-separated recipients. Empty uses Default Recipients from Manage Jenkins > System > Extended E-mail Notification, which is where the team list belongs.'
        )
        string(
            name: 'ACCOUNT_LOCK',
            defaultValue: 'cbse-cba-accounts',
            description: 'Lockable resource guarding the portal accounts. Held for the whole test phase, so a per-module build queues behind this one instead of signing it out. Give a second environment its own accounts and its own lock name.'
        )
    }

    options {
        timeout(time: 8, unit: 'HOURS')
        timestamps()
        // Needs the AnsiColor plugin; pairs with --color=yes, since pytest
        // drops colour when its output is a pipe rather than a terminal.
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    environment {
        CBSE_BASE_URL = "${params.CBSE_BASE_URL}"
        CBSE_HEADLESS = '1'
        // Every lane overrides this with its own directory. conftest reads
        // PYTEST_REPORTS_DIR precisely so concurrent pytest sessions keep
        // their report artifacts apart.
        PYTEST_REPORTS_DIR = "${WORKSPACE}/reports_ci"
        // A Jenkins agent has no ~/Downloads, so point the upload checks at
        // the template vendored in the repo.
        CBSE_UPLOAD_ITEM_FILE = "${WORKSPACE}/data/upload_templates/sme_sheet.xlsx"
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    cbse = load 'ci/jenkins/cbse.groovy'
                }
            }
        }

        stage('Set up Python') {
            steps {
                script { cbse.setUpPython() }
            }
        }

        stage('Load credentials') {
            steps {
                script { cbse.installEnvFile('cbse-smoke-env') }
            }
        }

        stage('Preflight') {
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            steps {
                // A half-booted environment fails every lane for the same
                // reason and buries the real signal. One cheap login-and-render
                // check decides whether the next few hours are worth spending.
                // The M3 probe xfails by design (KI-M3-ITM-001), so it exits 0
                // whenever the app renders at all.
                script {
                    cbse.classifyPytestResult(
                        'Preflight',
                        cbse.runPytest(
                            'tests/M3_Item_Testing/test_m3_item_testing_probe.py ' +
                            '--color=yes -p no:cacheprovider --no-header -q'
                        )
                    )
                }
            }
        }

        stage('Full suite') {
            options {
                // Held across both the parallel lanes and the serial tail, so
                // no per-module build can slip in between them and sign these
                // sessions out. Taken here rather than around the whole
                // pipeline so checkout and pip do not hold the queue.
                // params is empty on a job's very first build, which locked
                // "null" - a resource no other job shares - so fall back.
                lock(resource: params.ACCOUNT_LOCK ?: 'cbse-cba-accounts')
            }

            stages {
                stage('Modules') {
                    // failFast is deliberately left off: this job exists to
                    // produce a complete result, so one red lane must not
                    // discard the three that are still running.
                    parallel {
                        stage('M2 Web Portal Admin') {
                            environment {
                                PYTEST_REPORTS_DIR = "${WORKSPACE}/reports_ci/m2"
                                // Past M1+M5's accounts; see the header.
                                CBSE_ACCOUNT_SLOT_OFFSET = "${(!params.WORKERS || params.WORKERS == '0' || params.WORKERS == '1') ? '2' : params.WORKERS}"
                            }
                            options {
                                // One worker by default (see M2_WORKERS), and
                                // M2 serially has measured 2h13m on UAT.
                                timeout(time: 150, unit: 'MINUTES')
                            }
                            steps {
                                // `not serial` holds back the tests that
                                // mutate shared state — chiefly the one that
                                // deactivates every RWG account, which the
                                // M1+M5 lane is using right now. They run in
                                // the tail stage below.
                                script {
                                    cbse.runLane('M2', [
                                        'tests/M2_Web_Portal_Admin',
                                        cbse.markerArgs(['not serial'], params.INCLUDE_NIGHTLY, params.INCLUDE_PERFORMANCE),
                                        cbse.xdistArgs(params.M2_WORKERS),
                                        cbse.rerunArgs(params.RERUNS),
                                        cbse.reportingArgs(env.PYTEST_REPORTS_DIR),
                                    ].findAll { it }.join(' '))
                                }
                            }
                        }

                        stage('M3 + M4') {
                            environment {
                                PYTEST_REPORTS_DIR = "${WORKSPACE}/reports_ci/m3_m4"
                                CBSE_ACCOUNT_SLOT_OFFSET = "${(!params.WORKERS || params.WORKERS == '0' || params.WORKERS == '1') ? '2' : params.WORKERS}"
                            }
                            options {
                                timeout(time: 45, unit: 'MINUTES')
                            }
                            steps {
                                // M3 is a probe over a module the build does
                                // not ship yet; M4 drives one QP teacher past
                                // M1+M5's teachers (teacher3 by default).
                                script {
                                    cbse.runLane('M3+M4', [
                                        'tests/M3_Item_Testing',
                                        'tests/M4_QP_Creation',
                                        cbse.markerArgs([], params.INCLUDE_NIGHTLY, params.INCLUDE_PERFORMANCE),
                                        cbse.xdistArgs(params.LIGHT_WORKERS),
                                        cbse.rerunArgs(params.RERUNS),
                                        cbse.reportingArgs(env.PYTEST_REPORTS_DIR),
                                    ].findAll { it }.join(' '))
                                }
                            }
                        }

                        stage('M1 + M5') {
                            environment {
                                PYTEST_REPORTS_DIR = "${WORKSPACE}/reports_ci/m1_m5"
                            }
                            options {
                                // Build #1 (2026-09-29) was killed here at 180:
                                // the `serial` group's reviewer e2e flows run
                                // on one worker for 2h+ after the rest finish,
                                // and a killed lane writes no junit at all.
                                // 300 with 2 workers; one worker runs M1+M5
                                // end to end in ~4-4.5h (2026-10-05 estimate).
                                timeout(time: 360, unit: 'MINUTES')
                            }
                            steps {
                                // One process over both paths on purpose — see
                                // the header. Only tests/M1_Item_Bank_Mgmt
                                // counts as M1 here: tests/_unit is left out
                                // of the daily run by choice (2026-09-30), and
                                // Jenkinsfile.module still runs it for M1.
                                // This is the critical path, so WORKERS is the
                                // parameter that decides the build's length.
                                script {
                                    cbse.runLane('M1+M5', [
                                        'tests/M1_Item_Bank_Mgmt',
                                        'tests/M5_Teacher_Contribution',
                                        cbse.markerArgs([], params.INCLUDE_NIGHTLY, params.INCLUDE_PERFORMANCE),
                                        cbse.xdistArgs(params.WORKERS),
                                        cbse.rerunArgs(params.RERUNS),
                                        cbse.reportingArgs(env.PYTEST_REPORTS_DIR),
                                    ].findAll { it }.join(' '))
                                }
                            }
                        }
                    }
                }

                stage('M2 serial tail') {
                    environment {
                        PYTEST_REPORTS_DIR = "${WORKSPACE}/reports_ci/m2_serial"
                    }
                    options {
                        timeout(time: 45, unit: 'MINUTES')
                    }
                    steps {
                        // Runs alone, without xdist: these tests take review
                        // roles offline and edit QAR configuration, which is
                        // global state. Everything that could notice has
                        // already finished.
                        script {
                            cbse.runLane('M2 serial', [
                                'tests/M2_Web_Portal_Admin',
                                cbse.markerArgs(['serial'], params.INCLUDE_NIGHTLY, params.INCLUDE_PERFORMANCE),
                                cbse.rerunArgs(params.RERUNS),
                                cbse.reportingArgs(env.PYTEST_REPORTS_DIR),
                            ].findAll { it }.join(' '))
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            // One module-level summary across all lanes, built first so the
            // archive step below captures it. This is the report to share;
            // the per-lane reports are for whoever debugs a failure.
            script {
                String title = (env.JOB_BASE_NAME == 'cbse-daily' ? 'CBSE Daily Regression' : 'CBSE Full Suite') +
                    " #${env.BUILD_NUMBER}"
                summarySubject = cbse?.buildSummary('reports_ci', title)
            }
            // allowEmptyResults keeps an environment-level failure (no lane
            // ever started) reporting as a build failure rather than masking it
            // as a Jenkins config error about missing results.
            junit testResults: 'reports_ci/*/junit.xml', allowEmptyResults: true
            archiveArtifacts(
                artifacts: 'reports_ci/**/*, screenshots/**/*',
                allowEmptyArchive: true,
                fingerprint: false
            )
            publishHTML(target: [
                reportDir: 'reports_ci',
                reportFiles: 'daily_summary.html',
                reportName: 'CBSE Summary',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: true
            ])
            script {
                cbse?.publishLane('reports_ci/m1_m5', 'CBSE M1+M5 Report')
                cbse?.publishLane('reports_ci/m2', 'CBSE M2 Report')
                cbse?.publishLane('reports_ci/m2_serial', 'CBSE M2 Serial Report')
                cbse?.publishLane('reports_ci/m3_m4', 'CBSE M3+M4 Report')
                if (params.SEND_REPORT) {
                    // A mail-server hiccup must not turn a finished run red.
                    try {
                        cbse?.emailSummary('reports_ci', summarySubject, params.NOTIFY_EMAILS)
                    } catch (err) {
                        echo "Summary mail was not sent: ${err}"
                    }
                }
            }
        }
        unstable {
            echo 'Tests failed. Start from the CBSE Summary report, then open the lane report for the failing module.'
        }
        cleanup {
            // The decrypted .env holds real account passwords and must not sit
            // in the workspace between builds. Screenshots run to hundreds of
            // MB across builds; the archive above already took this build's.
            // reports_ci goes too: a lane that does not run tomorrow would
            // otherwise leave today's junit.xml behind, and the summary would
            // report it as tomorrow's result.
            script {
                cbse?.removeEnvFile()
                cbse?.runShell(
                    'rm -rf screenshots/* tmp_uploads/* reports_ci || true',
                    'if exist screenshots rmdir /s /q screenshots & if exist tmp_uploads rmdir /s /q tmp_uploads & if exist reports_ci rmdir /s /q reports_ci & exit /b 0'
                )
            }
        }
    }
}
